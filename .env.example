# API origin the client calls. Baked into the build at `npm run build` time —
# rebuild (and re-run `npx cap sync android`) after changing this for the
# Capacitor app to pick it up.
#
# Web dev:              http://localhost:5000/api
# Android emulator dev: http://10.0.2.2:5000/api        (emulator's alias for the host machine's localhost)
# Physical device dev:  http://<dev-machine-LAN-IP>:5000/api
# Deployed backend:     https://<your-real-api-host>/api
VITE_API_URL=http://localhost:5000/api

# Error tracking (self-hosted GlitchTip, Sentry-protocol-compatible) — the
# Client project's DSN. Optional: if unset, error tracking is silently
# disabled (errors still reach the browser console via ErrorBoundary).
VITE_SENTRY_DSN=
